{
    "$comment": "docs/risk-tiers.md is the source; this file restates its tier table as data. scripts/check-policies.mjs fails when the two disagree (tier number, name, paths, required commands, review). Tier 1 is the MOST dangerous tier. Paths are input to a classifier, not the classifier: tier is set by what a change can break, so a reviewer's judgment can raise a tier above the path match but never lower it below.",
    "default_tier": 3,
    "tiers": [
        {
            "tier": 1,
            "name": "critical",
            "paths": [
                "backend/migrations/**",
                "backend/models/**",
                "backend/middleware/**",
                "backend/services/backupService.js",
                "Dockerfile",
                "scripts/docker-entrypoint.sh",
                ".github/workflows/**",
                ".github/CODEOWNERS",
                "policies/**",
                "risk-config.json",
                "LICENSE*",
                "package.json",
                "package-lock.json",
                "AGENTS.md"
            ],
            "required_commands": [
                "npm run lint",
                "npm run backend:test",
                "npm run backend:test:pg",
                "npm run backend:test:upgrade"
            ],
            "review": "owner"
        },
        {
            "tier": 2,
            "name": "high",
            "paths": [
                "backend/modules/auth/**",
                "backend/modules/oidc/**",
                "backend/modules/oauth/**",
                "backend/modules/backup/**",
                "backend/modules/telegram/**",
                "backend/modules/mcp/**",
                "backend/modules/ai-assistant/**",
                "backend/config/**",
                "backend/services/permissionsService.js",
                "backend/services/sessionService.js",
                "docker-compose.yml",
                "docker-compose.dev.yml"
            ],
            "required_commands": [
                "npm run lint",
                "npm run backend:test"
            ],
            "review": "owner"
        },
        {
            "tier": 3,
            "name": "medium",
            "paths": [
                "backend/modules/**",
                "backend/services/**",
                "backend/utils/**",
                "backend/tests/**",
                "frontend/**",
                "e2e/**",
                "CLAUDE.md"
            ],
            "required_commands": [
                "npm run lint",
                "npm run backend:test",
                "npm run frontend:test"
            ],
            "review": "ci"
        },
        {
            "tier": 4,
            "name": "low",
            "paths": [
                "docs/**",
                "public/locales/**",
                "*.md",
                ".editorconfig"
            ],
            "required_commands": [],
            "review": "ci"
        }
    ]
}
