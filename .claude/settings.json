{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "allow": [
            "Bash(npm run lint)",
            "Bash(npm run format)",
            "Bash(npm test)",
            "Bash(npm test:*)",
            "Bash(npm run test:*)",
            "Bash(npm run backend:test:*)",
            "Bash(npm run backend:test)",
            "Bash(npm run backend:lint)",
            "Bash(npm run frontend:test:*)",
            "Bash(npm run frontend:test)",
            "Bash(npm run frontend:lint)",
            "Bash(node --test:*)",
            "Bash(git status:*)",
            "Bash(git diff:*)",
            "Bash(git log:*)",
            "Bash(git show:*)",
            "Bash(git branch:*)"
        ],
        "ask": [
            "Bash(git push:*)",
            "Edit(.github/workflows/**)",
            "Write(.github/workflows/**)",
            "Edit(backend/migrations/**)",
            "Write(backend/migrations/**)",
            "Edit(LICENSE*)",
            "Write(LICENSE*)"
        ],
        "deny": [
            "Bash(git push --force:*)",
            "Bash(git push -f:*)",
            "Bash(git push --force-with-lease:*)",
            "Bash(git reset --hard:*)",
            "Edit(LICENSE.MIT)",
            "Write(LICENSE.MIT)",
            "Read(./.env)",
            "Read(./.env.*)",
            "Read(./backend/.env)",
            "Read(./backend/.env.*)"
        ]
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.mjs\""
                    }
                ]
            }
        ]
    }
}
