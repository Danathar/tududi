{
    "$comment": "Workflow hygiene for .github/workflows. Evaluated by scripts/check-policies.mjs. See docs/security/SECURITY-AI.md.",
    "workflowGlobs": [
        ".github/workflows/*.yml",
        ".github/workflows/*.yaml"
    ],
    "requireTopLevelPermissions": true,
    "forbiddenTriggers": [
        "pull_request_target"
    ],
    "trustedActionOwners": [
        "actions",
        "github"
    ],
    "pinPattern": "^[0-9a-f]{40}$",
    "ghWriteNeedsRepo": true,
    "ghWriteCommandPattern": "\\bgh\\s+(?:(?:pr|issue|release|workflow|label)\\s+(?:create|comment|edit|close|reopen|merge|review|delete|run|enable|disable|ready|upload|delete-asset|lock|unlock|transfer|pin|unpin|update-branch|develop)|run\\s+(?:rerun|cancel|delete))\\b",
    "allowedRepoValues": [
        "${{ github.repository }}",
        "Danathar/tududi",
        "\"$GH_REPO\"",
        "$GH_REPO"
    ]
}
