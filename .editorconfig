# EditorConfig: https://editorconfig.org
# Matches .prettierrc.json (4 spaces, LF) and the indentation already used in
# the repository: workflows, YAML, JSON and shell scripts use 2 spaces.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,sh}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false
